---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const artikelEntries = await getCollection("artikel", ({ data }) => !data.draft);

  return artikelEntries.map((artikel) => ({
    params: { slug: artikel.id },
    props: { artikel },
  }));
}

interface Props {
  artikel: CollectionEntry<"artikel">;
}

const { artikel } = Astro.props;
const { data } = artikel;
const { Content, headings } = await render(artikel);

// TOC nur aus Überschriften innerhalb des Artikeltexts (## und ###)
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${data.title} – Artikel`}>
  <article>
    <h1>{data.title}</h1>
    <p>{formatDate(data.date)} · {data.author}</p>
    {data.description && <p>{data.description}</p>}
    {data.image && <img src={data.image} alt={data.title} />}
    {data.categories.length > 0 && <p>Kategorien: {data.categories.join(", ")}</p>}
    {data.tags.length > 0 && <p>Tags: {data.tags.join(", ")}</p>}

    {tocHeadings.length > 1 && (
      <nav aria-label="Inhaltsverzeichnis">
        <h2>Inhalt</h2>
        <ul>
          {tocHeadings.map((h) => (
            <li style={h.depth === 3 ? "margin-left: 1em" : undefined}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <Content />
  </article>
</Base>
