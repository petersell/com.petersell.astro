---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const artikelEntries = await getCollection("artikel", ({ data }) => !data.draft);

  return artikelEntries.map((artikel) => ({
    params: { slug: artikel.id },
    props: { artikel },
  }));
}

interface Props {
  artikel: CollectionEntry<"artikel">;
}

const { artikel } = Astro.props;
const { data } = artikel;
const { Content, headings } = await render(artikel);

// TOC nur aus Überschriften innerhalb des Artikeltexts (## und ###)
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
// Eingerückt wird nur, was tiefer liegt als die oberste Ebene im Artikel
const tocTopDepth = Math.min(...tocHeadings.map((h) => h.depth));

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${data.title} – Artikel`}>
  <article>
    <h1>{data.title}</h1>
    <p class="meta">
      {formatDate(data.date)} · {data.author}
      {data.categories.length > 0 && <> · {data.categories.join(", ")}</>}
      {data.tags.length > 0 && <> · {data.tags.join(", ")}</>}
    </p>
    {data.description && <p class="description">{data.description}</p>}
    {data.image && <img src={data.image} alt={data.title} />}

    {data.toc && tocHeadings.length > 2 && (
      <aside class="toc-rail">
        <nav class="toc" aria-label="Inhaltsverzeichnis">
          <h2>Inhalt</h2>
          <ul>
            {tocHeadings.map((h) => (
              <li class={h.depth > tocTopDepth ? "sub" : undefined}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}

    <Content />
  </article>
</Base>

<style>
  .description {
    color: var(--color-muted);
    font-style: italic;
  }

  .toc {
    margin: 1.5rem 0;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .toc h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc li {
    margin: 0.3rem 0;
    line-height: 1.35;
  }

  .toc .sub {
    padding-left: 1rem;
    font-size: 0.9em;
  }

  .toc a {
    text-decoration: none;
  }

  .toc a:hover {
    text-decoration: underline;
  }

  /* Breite Bildschirme: TOC rechts neben dem Text, bleibt beim Scrollen stehen.
     Die Leiste reicht über die ganze Artikelhöhe, das TOC klebt darin. */
  @media (min-width: 80rem) {
    article {
      position: relative;
    }

    .toc-rail {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(100% + 2.5rem);
      width: 16rem;
    }

    .toc {
      position: sticky;
      top: 1.5rem;
      margin: 0;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      font-size: 0.85rem;
    }
  }
</style>
