---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const artikelEntries = await getCollection("artikel", ({ data }) => !data.draft);

  return artikelEntries.map((artikel) => ({
    params: { slug: artikel.id },
    props: { artikel },
  }));
}

interface Props {
  artikel: CollectionEntry<"artikel">;
}

const { artikel } = Astro.props;
const { data } = artikel;
const { Content, headings } = await render(artikel);

// TOC nur aus Überschriften innerhalb des Artikeltexts (## und ###)
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${data.title} – Artikel`}>
  <article>
    <h1>{data.title}</h1>
    <p class="meta">
      {formatDate(data.date)} · {data.author}
      {data.categories.length > 0 && <> · {data.categories.join(", ")}</>}
      {data.tags.length > 0 && <> · {data.tags.join(", ")}</>}
    </p>
    {data.description && <p class="description">{data.description}</p>}
    {data.image && <img src={data.image} alt={data.title} />}

    {tocHeadings.length > 1 && (
      <nav class="toc" aria-label="Inhaltsverzeichnis">
        <h2>Inhalt</h2>
        <ul>
          {tocHeadings.map((h) => (
            <li class={h.depth === 3 ? "sub" : undefined}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <Content />
  </article>
</Base>

<style>
  .description {
    color: var(--color-muted);
    font-style: italic;
  }

  .toc {
    margin: 1.5rem 0;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .toc h2 {
    margin-top: 0;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .toc ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  .toc .sub {
    margin-left: 1rem;
  }
</style>

