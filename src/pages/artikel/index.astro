---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const artikelEntries = (await getCollection("artikel", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Artikel">
  <h1>Artikel</h1>
  <ul>
    {artikelEntries.map((artikel) => (
      <li>
        <a href={`/artikel/${artikel.id}/`}>{artikel.data.title}</a>
        <p>{formatDate(artikel.data.date)}</p>
        {artikel.data.description && <p>{artikel.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>
