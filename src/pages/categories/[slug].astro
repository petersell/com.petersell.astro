---
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { capitalize, getTaxonomyTerms } from "../../lib/taxonomy";
import type { TaxonomyTerm } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const terms = await getTaxonomyTerms("categories");
  return [...terms.values()].map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

interface Props {
  term: TaxonomyTerm;
}

const { term } = Astro.props;
---

<Base title={`Kategorie: ${capitalize(term.label)}`}>
  <h1>Kategorie: {capitalize(term.label)}</h1>
  <EntryList entries={term.entries} />
</Base>

