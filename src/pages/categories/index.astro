---
import Base from "../../layouts/Base.astro";
import { capitalize, getTaxonomyTerms } from "../../lib/taxonomy";

const terms = [...(await getTaxonomyTerms("categories")).values()].sort(
  (a, b) => b.entries.length - a.entries.length,
);
---

<Base title="Kategorien">
  <h1>Kategorien</h1>
  <ul class="cloud">
    {terms.map((term) => (
      <li>
        <a href={`/categories/${term.slug}/`}>{capitalize(term.label)}</a>
        <span class="count">{term.entries.length}</span>
      </li>
    ))}
  </ul>
</Base>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cloud li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
  }

  .cloud a {
    text-decoration: none;
    font-weight: 600;
  }

  .cloud a:hover {
    text-decoration: underline;
  }

  .count {
    color: var(--color-muted);
    font-size: 0.85rem;
  }
</style>

