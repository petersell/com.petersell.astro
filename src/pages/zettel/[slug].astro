---
import { getCollection, getEntries, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import TagLinks from "../../components/TagLinks.astro";
import { capitalize } from "../../lib/taxonomy";
import type { CollectionEntry } from "astro:content";
import { buildBacklinkIndex, getBacklinksFor, type Backlink } from "../../lib/backlinks";

export async function getStaticPaths() {
  const zettelEntries = await getCollection("zettel", ({ data }) => !data.draft);
  const backlinkIndex = await buildBacklinkIndex();

  return zettelEntries.map((zettel) => ({
    params: { slug: zettel.id },
    props: { zettel, backlinks: getBacklinksFor(backlinkIndex, `/zettel/${zettel.id}/`) },
  }));
}

interface Props {
  zettel: CollectionEntry<"zettel">;
  backlinks: Backlink[];
}

const { zettel, backlinks } = Astro.props;
const { data } = zettel;
const { Content } = await render(zettel);

const quellen = data.signaturen.length > 0 ? await getEntries(data.signaturen) : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${data.title} – Zettel`}>
  <article>
    {data.image && (
      <img class="cover" src={data.image} alt={`Buchcover von ${data.title}`} width="140" />
    )}
    <h1>{data.title}</h1>
    <p class="meta">
      {formatDate(data.date)} · Zettel {data.zettelnummer}
      {data.categories.length > 0 && <> · {data.categories.map(capitalize).join(", ")}</>}
      {data.tags.length > 0 && <> · <TagLinks tags={data.tags} /></>}
    </p>

    <Content />

    {quellen.length > 0 && (
      <p class="quelle">
        Quelle:{" "}
        {quellen.map((q, i) => (
          <>
            {i > 0 && ", "}
            <a href={`/quellen/${q.id}/`}>{q.data.title}</a>
          </>
        ))}
        {data.seite && <> – S. {data.seite}</>}
      </p>
    )}

    {backlinks.length > 0 && (
      <section class="backlinks">
        <h2>Elternzettel + Backlinks</h2>
        <ul>
          {backlinks.map((b) => (
            <li>
              <a href={b.href}>{b.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>

<style>
  .cover {
    float: right;
    margin: 0 0 1rem 1.5rem;
  }

  .quelle,
  .backlinks {
    margin-top: 2rem;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .backlinks h2 {
    margin-top: 0;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .backlinks ul {
    margin: 0;
    padding-left: 1.25rem;
  }
</style>

