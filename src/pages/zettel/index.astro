---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const zettelEntries = (await getCollection("zettel", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Zettelkasten">
  <h1>Zettelkasten</h1>
  <ul>
    {zettelEntries.map((zettel) => (
      <li>
        <a href={`/zettel/${zettel.id}/`}>{zettel.data.title}</a>
        {" "}– Zettel {zettel.data.zettelnummer}
        <p>{formatDate(zettel.data.date)}</p>
      </li>
    ))}
  </ul>
</Base>
