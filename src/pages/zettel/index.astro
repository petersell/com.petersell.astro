---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const zettelEntries = (await getCollection("zettel", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Zettelkasten">
  <h1>Zettelkasten</h1>
  <ul class="entries">
    {zettelEntries.map((zettel) => (
      <li>
        <a href={`/zettel/${zettel.id}/`}>{zettel.data.title}</a>
        <p class="meta">Zettel {zettel.data.zettelnummer} · {formatDate(zettel.data.date)}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entries li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .entries a {
    font-weight: 600;
    text-decoration: none;
  }

  .entries a:hover {
    text-decoration: underline;
  }

  .entries p {
    margin: 0.15rem 0 0;
  }
</style>

