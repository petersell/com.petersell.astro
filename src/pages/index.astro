---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { getSerien, serieHref } from "../lib/serie";

const FEED_LIMIT = 15;

const artikelEntries = await getCollection("artikel", ({ data }) => !data.draft);
const statusEntries = await getCollection("status", ({ data }) => !data.draft);

const feed = [
  ...artikelEntries.map((entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    href: `/artikel/${entry.id}/`,
    typeLabel: "Artikel",
    description: entry.data.description,
  })),
  ...(await getSerien()).map(({ overview }) => ({
    title: overview.data.title,
    date: overview.data.date,
    href: serieHref(overview),
    typeLabel: "Serie",
    description: overview.data.description,
  })),
  ...statusEntries.map((entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    href: `/status/${entry.id}/`,
    typeLabel: "Status",
    description: entry.data.description,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, FEED_LIMIT);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Andreas Petersell">
  <h1>Andreas Petersell</h1>
  <p class="tagline">Technischer Redakteur, Autor, Blogger.</p>

  <h2>Neueste Beiträge</h2>
  <ul class="entries">
    {feed.map((item) => (
      <li>
        <span class="type">{item.typeLabel}</span>
        {" "}<a href={item.href}>{item.title}</a>
        <p class="meta">{formatDate(item.date)}</p>
        {item.description && <p class="description">{item.description}</p>}
      </li>
    ))}
  </ul>
</Base>

<style>
  .tagline {
    color: var(--color-muted);
    margin-top: -0.5rem;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entries li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .type {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-accent);
  }

  .entries a {
    font-weight: 600;
    text-decoration: none;
  }

  .entries a:hover {
    text-decoration: underline;
  }

  .entries p {
    margin: 0.15rem 0 0;
  }

  .description {
    color: var(--color-muted);
    font-style: italic;
  }
</style>

