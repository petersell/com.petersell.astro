---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { getSerien, serieHref } from "../lib/serie";
import EntryList from "../components/EntryList.astro";
import type { ListEntry } from "../lib/taxonomy";

const FEED_LIMIT = 15;

const artikelEntries = await getCollection("artikel", ({ data }) => !data.draft);
const statusEntries = await getCollection("status", ({ data }) => !data.draft);

const feed: ListEntry[] = [
  ...artikelEntries.map((entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    href: `/artikel/${entry.id}/`,
    typeLabel: "Artikel",
    description: entry.data.description,
    categories: entry.data.categories,
    tags: entry.data.tags,
  })),
  ...(await getSerien()).map(({ overview }) => ({
    title: overview.data.title,
    date: overview.data.date,
    href: serieHref(overview),
    typeLabel: "Serie",
    description: overview.data.description,
    categories: overview.data.categories,
    tags: overview.data.tags,
  })),
  ...statusEntries.map((entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    href: `/status/${entry.id}/`,
    typeLabel: "Status",
    description: entry.data.description,
    categories: entry.data.categories,
    tags: entry.data.tags,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, FEED_LIMIT);
---

<Base title="Andreas Petersell">
  <h1 class="brand">
    <img src="/petersell-logo.png" alt="" width="52" height="55" />
    Andreas Petersell
  </h1>
  <p class="tagline">Technischer Redakteur, Autor, Blogger.</p>

  <h2>Neueste Beiträge</h2>
  <EntryList entries={feed} />
</Base>

<style>
  /* Logo vor dem Namen; Name und h2 in Anthrazit wie auf www.petersell.com */
  /* baseline: Unterkante des Logos steht auf der Grundlinie des Namens */
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    color: var(--color-heading);
  }

  h2 {
    color: var(--color-heading);
  }

  /* Originalgröße 52×55 px, fast doppelt so hoch wie die Großbuchstaben */
  .brand img {
    height: 55px;
    width: auto;
    border-radius: 0;
  }

  .tagline {
    color: var(--color-muted);
    margin-top: -0.5rem;
  }
</style>

