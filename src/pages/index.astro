---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const FEED_LIMIT = 15;

const artikelEntries = await getCollection("artikel", ({ data }) => !data.draft);
const statusEntries = await getCollection("status", ({ data }) => !data.draft);

const feed = [
  ...artikelEntries.map((entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    href: `/artikel/${entry.id}/`,
    typeLabel: "Artikel",
    description: entry.data.description,
  })),
  ...statusEntries.map((entry) => ({
    title: entry.data.title,
    date: entry.data.date,
    href: `/status/${entry.id}/`,
    typeLabel: "Status",
    description: entry.data.description,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, FEED_LIMIT);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Andreas Petersell">
  <h1>Andreas Petersell</h1>
  <p>Technischer Redakteur, Autor, Blogger.</p>

  <h2>Neueste Beiträge</h2>
  <ul>
    {feed.map((item) => (
      <li>
        <small>{item.typeLabel}</small>
        {" "}<a href={item.href}>{item.title}</a>
        <p>{formatDate(item.date)}</p>
        {item.description && <p>{item.description}</p>}
      </li>
    ))}
  </ul>
</Base>
