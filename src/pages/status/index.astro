---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const statusEntries = (await getCollection("status", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Status">
  <h1>Status</h1>
  <ul>
    {statusEntries.map((status) => (
      <li>
        {status.data.image && <img src={status.data.image} alt={status.data.title} width="150" />}
        <a href={`/status/${status.id}/`}>{status.data.title}</a>
        <p>{formatDate(status.data.date)}</p>
        {status.data.description && <p>{status.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>
