---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const statusEntries = (await getCollection("status", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Status">
  <h1>Status</h1>
  <ul class="entries">
    {statusEntries.map((status) => (
      <li>
        {status.data.image && (
          <img class="thumb" src={status.data.image} alt={status.data.title} width="96" />
        )}
        <div>
          <a href={`/status/${status.id}/`}>{status.data.title}</a>
          <p class="meta">{formatDate(status.data.date)}</p>
          {status.data.description && <p class="description">{status.data.description}</p>}
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entries li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .thumb {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    object-fit: cover;
  }

  .entries a {
    font-weight: 600;
    text-decoration: none;
  }

  .entries a:hover {
    text-decoration: underline;
  }

  .entries p {
    margin: 0.15rem 0 0;
  }

  .description {
    color: var(--color-muted);
    font-style: italic;
  }
</style>

