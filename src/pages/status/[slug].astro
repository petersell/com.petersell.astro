---
import { getCollection, getEntries, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import TagLinks from "../../components/TagLinks.astro";
import { capitalize } from "../../lib/taxonomy";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const statusEntries = await getCollection("status", ({ data }) => !data.draft);

  return statusEntries.map((status) => ({
    params: { slug: status.id },
    props: { status },
  }));
}

interface Props {
  status: CollectionEntry<"status">;
}

const { status } = Astro.props;
const { data } = status;
const { Content } = await render(status);

const quellen = data.signaturen.length > 0 ? await getEntries(data.signaturen) : [];

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${data.title} – Status`}>
  <article>
    <h1>{data.title}</h1>
    <p class="meta">
      {formatDate(data.date)}
      {data.categories.length > 0 && <> · {data.categories.map(capitalize).join(", ")}</>}
      {data.tags.length > 0 && <> · <TagLinks tags={data.tags} /></>}
    </p>
    {data.description && <p class="description">{data.description}</p>}

    <Content />

    {quellen.length > 0 && (
      <p class="quelle">
        Quelle:{" "}
        {quellen.map((q, i) => (
          <>
            {i > 0 && ", "}
            <a href={`/quellen/${q.id}/`}>{q.data.title}</a>
          </>
        ))}
      </p>
    )}
  </article>
</Base>

<style>
  .description {
    color: var(--color-muted);
    font-style: italic;
  }

  /* Hochkant-Bilder (Klasse vom portrait-images-Plugin) nur 75 % breit */
  article :global(img.portrait) {
    max-width: 75%;
  }

  .quelle {
    margin-top: 2rem;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
</style>

