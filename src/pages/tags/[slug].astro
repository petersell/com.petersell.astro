---
import Base from "../../layouts/Base.astro";
import { getTaxonomyTerms } from "../../lib/taxonomy";
import type { TaxonomyTerm } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const terms = await getTaxonomyTerms("tags");
  return [...terms.values()].map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

interface Props {
  term: TaxonomyTerm;
}

const { term } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString("de-DE", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`Tag: ${term.label}`}>
  <h1>Tag: {term.label}</h1>
  <ul class="entries">
    {term.entries.map((entry) => (
      <li>
        <span class="type">{entry.collectionLabel}</span>
        {" "}<a href={entry.href}>{entry.title}</a>
        <p class="meta">{formatDate(entry.date)}</p>
      </li>
    ))}
  </ul>
</Base>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entries li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entries li:first-child {
    border-top: 1px solid var(--color-border);
  }

  .type {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-accent);
  }

  .entries a {
    font-weight: 600;
    text-decoration: none;
  }

  .entries a:hover {
    text-decoration: underline;
  }

  .entries p {
    margin: 0.15rem 0 0;
  }
</style>

