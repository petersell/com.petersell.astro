---
import Base from "../../layouts/Base.astro";
import EntryList from "../../components/EntryList.astro";
import { getTaxonomyTerms } from "../../lib/taxonomy";
import type { TaxonomyTerm } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const terms = await getTaxonomyTerms("tags");
  return [...terms.values()].map((term) => ({
    params: { slug: term.slug },
    props: { term },
  }));
}

interface Props {
  term: TaxonomyTerm;
}

const { term } = Astro.props;
---

<Base title={`Stichwort: ${term.label}`}>
  <h1>Stichwort: {term.label}</h1>
  <EntryList entries={term.entries} />
</Base>

